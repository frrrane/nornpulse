# =========================================================
# ⚡ NornPulse: Autonomous Media Engine - Environment Config
# Norn Labs (nornlabs.ai)
# Copy this file to .env and fill in your values.
# =========================================================

# Google Gemini API Key (Gemini 2.0 Flash)
GEMINI_API_KEY=your_gemini_api_key_here

# ----------------------------------------------------------
# Vertex AI routing (agent/genai_client.py)
#   Off by default: model calls go to Google AI Studio on the
#   GEMINI_API_KEY above. Set NORNPULSE_USE_VERTEX=true to route the
#   same google-genai client through Vertex AI instead, billed to a
#   Google Cloud project via GOOGLE_APPLICATION_CREDENTIALS (or
#   Application Default Credentials) rather than an API key.
# ----------------------------------------------------------
NORNPULSE_USE_VERTEX=false
NORNPULSE_VERTEX_PROJECT=your-gcp-project-id
# NORNPULSE_VERTEX_LOCATION=us-central1   # optional override; each model has a verified default in genai_client.py

# ----------------------------------------------------------
# Demo Mode
#   true  → INPUT_VIDEO_SOURCE is ignored; the pipeline uses
#           the public-domain Carl Sagan Senate Speech (1985)
#           hosted on Wikimedia Commons automatically.
#   false → INPUT_VIDEO_SOURCE must point to a valid URL or
#           local file path.
# ----------------------------------------------------------
DEMO_MODE=true

# Input video source (only used when DEMO_MODE=false)
INPUT_VIDEO_SOURCE=https://upload.wikimedia.org/wikipedia/commons/transcoded/c/c2/Carl_Sagan_Senate_Speech_1985_%28Excerpt%29.webm/Carl_Sagan_Senate_Speech_1985_%28Excerpt%29.webm.480p.vp9.webm

# ClickHouse Database Connection
# Read directly by the official ClickHouse MCP server (mcp-clickhouse),
# which agent/clickhouse_mcp_client.py launches as a subprocess — see
# https://github.com/ClickHouse/mcp-clickhouse for the full variable list.
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default
# false for the local docker-compose instance (plain HTTP); set to true
# for ClickHouse Cloud or any TLS-terminated endpoint.
CLICKHOUSE_SECURE=false

# Application Settings
LOG_LEVEL=INFO
APP_PORT=8501

